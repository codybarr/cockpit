diff --git a/Tests/CockpitTests/FilenameIndexTests.swift b/Tests/CockpitTests/FilenameIndexTests.swift
index 2689fc3..0df16f2 100644
--- a/Tests/CockpitTests/FilenameIndexTests.swift
+++ b/Tests/CockpitTests/FilenameIndexTests.swift
@@ -43,6 +43,25 @@ final class FilenameIndexTests: XCTestCase {
         wait(for: [refreshed], timeout: 3)
     }
 
+    func testAbsentASCIITrigramsAndShortQueriesMatchBruteForce() {
+        let files = ["Quarterly Report.pdf", "Cafe\u{301}.txt", "ab.txt", "zz-top.txt"].map {
+            FilenameCandidate(url: URL(fileURLWithPath: "/fixture/\($0)"))
+        }
+        let snapshot = FilenameSearchSnapshot(files)
+        for query in ["zzz", "nomatch", "ab", "", "report", "cafe", "zz-", "q", "qqq", "abcxyz"] {
+            let normalized = SearchNormalizer.normalize(query)
+            XCTAssertEqual(snapshot.matches(for: normalized), Array(files.filter { $0.normalizedName.contains(normalized) }.prefix(100)), query)
+        }
+    }
+
+    func testUnicodeCanonicalEquivalentFallbackIsPreserved() {
+        let files = [FilenameCandidate(url: URL(fileURLWithPath: "/fixture/각각각"))]
+        let decomposed = "\u{1100}\u{1161}\u{11A8}\u{1100}\u{1161}\u{11A8}\u{1100}\u{1161}\u{11A8}"
+        let normalized = SearchNormalizer.normalize(decomposed)
+        XCTAssertTrue(files[0].normalizedName.contains(normalized))
+        XCTAssertEqual(FilenameSearchSnapshot(files).matches(for: normalized), files)
+    }
+
